APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///./data/restaurant.db
ACCESS_TOKEN_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TAX_RATE_BPS=1000

# ---------------------------------------------------------------------------
# Platform (Super Admin) realm — separate identity, tokens, and cookies.
# Production requires every value below; startup fails fast when they are
# missing or unsafe. Local development may leave the secrets empty (a stable
# dev-only key is derived) and uses PLATFORM_DEV_ADMIN_ORIGINS for LAN access.
# ---------------------------------------------------------------------------
PLATFORM_SECRET_KEY=
PLATFORM_MFA_KEY=
# Exact browser origin of the admin console, e.g. https://admin.example.com
PLATFORM_ADMIN_ORIGIN=
# Dev only, ignored in production: comma-separated extra origins.
PLATFORM_DEV_ADMIN_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PLATFORM_TENANT_ORIGIN=
PLATFORM_API_ORIGIN=
PLATFORM_COOKIE_SECURE=false
PLATFORM_BOOTSTRAP_EMAIL=
PLATFORM_BOOTSTRAP_PASSWORD=
PLATFORM_BOOTSTRAP_MFA_SECRET=

# Production owner bootstrap (also used only when the deployed DB is empty):
# Development auto-seeds a demo restaurant; production never does. On an empty
# production database the server bootstraps one restaurant and one owner from
# these values — no demo accounts, menu, or tables.
RESTAURANT_NAME=
CURRENCY_CODE=NPR
TIMEZONE=Asia/Kathmandu
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=
