APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///./data/restaurant.db
ACCESS_TOKEN_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TAX_RATE_BPS=1000

# Production only (APP_ENV=production):
# Development auto-seeds a demo restaurant; production never does. On an empty
# production database the server bootstraps one restaurant and one owner from
# these values — no demo accounts, menu, or tables.
RESTAURANT_NAME=
CURRENCY_CODE=NPR
TIMEZONE=Asia/Kathmandu
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=
