# Copy to .env and adjust. VITE_* values are compiled into the client bundle —
# never put secrets here.
# Public brand shown on the landing/login pages (leave empty for the default).
VITE_BRAND_NAME=
# One-click demo accounts for sales demos (home page + login chips).
# Set to 0 for real-restaurant deployments; anything else keeps them visible.
VITE_DEMO_ACCOUNTS=1

# Super Admin console (separate build entry; admin origin in production).
# API origin used by the admin app and by CSP connect-src. Leave empty for local
# dev, where the shared Vite server proxies /api same-origin. No trailing slash.
# Production builds require this value (see vite.admin.config.ts).
VITE_PLATFORM_API_URL=
# Environment badge shown in the console: LOCAL / STAGING / PRODUCTION.
# Defaults to LOCAL in dev and PRODUCTION in a production build.
VITE_PLATFORM_ENV=
