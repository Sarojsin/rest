apps/web/build/
apps/web/.next/
apps/web/.nuxt/
apps/web/.expo/
apps/web/package-lock.json

# IDE and editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# System temporary files
*tmp
*.swp
*.swo
*~

# Additional log files
backend/*.log
frontend/*.log

# Environment-specific files
.env.local
.env.development.local
.env.test.local
.env.production.local

# Docker files (for local development)
.dockerignore
Dockerfile*
docker-compose*.yml

# Python virtual environments
.env
.venv*

# Git credentials
.git-credentials

# SSH keys
*.pem
*.key

# Database dumps
dumps/*.sql

# Coverage reports
coverage.xml

# Test reports
junit*.xml

# Vercel and Netlify files
.vercel
.netlify

# CI/CD files
.github/workflows/*
# ...except the keep-alive ping that prevents the free Render API from idling.
!.github/workflows/keep-alive.yml

# Security scan results
*.scan

# Temporary build files
*.bak
*.tmp
*.temp

# Vim swap files
.*.swp
.*.swo

# Eclipse workspace files
.cproject
.c_tags

# Jupyter notebook files
.ipynb_checkpoints

# Log files from Windows Event Log
*.evt
*.evtx

# Adobe Font Metrics
*.afm

# Mac OS-specific files
.DS_Store

# Windows shortcuts
*.lnk

# Package manager cache directories (e.g., npm, pip, cargo, etc.)
.vscode
.idea
.vagrant
*.log
*.pyc

# Sensitive data (already present)
# FCM server credentials — never commit service-account keys
*service-account*.json

# Local notes that contain plaintext dev credentials — never commit
tt.txt

# Important: Never commit credentials or secrets
# NOTE: *.json is intentionally NOT ignored here — package.json, opencode.json,
# tsconfig.json, etc. must be tracked. Only secret-bearing JSON should use
# more specific patterns below.
*.key
*.pem
*.crt
*.p12
*.der
*.cer

# Environment files — NEVER commit actual env files (template is OK to commit)
.env
.env.*
!.env.production.template
!.env.example

# OpenCode / MCP config — keep opencode.json tracked (contains no secrets), exclude any token files
.opencode/*
!opencode.json
.mcp-auth/

# Configuration files that may contain credentials
docker-compose*.yml
docker-compose*
Dockerfile*

